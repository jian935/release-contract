{"id":"ho-001","kind":"sample_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"undersized","volume_share":1.0,"n":75,"successes":74,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.01,"human_review_cost":0.0}],"expected":{"undersized":"HOLD"},"why":"a near-perfect rate on 75 observations is still shorter than the contracted evidence window"}
{"id":"ho-002","kind":"sample_gate","guardrails":{"min_sample_size":50,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"tiny_all_correct","volume_share":1.0,"n":20,"successes":20,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.01,"human_review_cost":0.0}],"expected":{"tiny_all_correct":"HOLD"},"why":"even after lowering min_sample_size to 50, 20 observations cannot carry a release claim"}
{"id":"ho-003","kind":"sample_gate","guardrails":{"min_sample_size":50,"min_success_rate":0.85,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"relaxed_contract","volume_share":1.0,"n":50,"successes":49,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.01,"human_review_cost":0.0}],"expected":{"relaxed_contract":"AUTO"},"why":"with both thresholds relaxed, lower 0.8950 clears 0.85 and n clears 50; verdicts follow the contract, not a hidden constant"}
{"id":"ho-004","kind":"wilson_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"thirteen_failures","volume_share":1.0,"n":150,"successes":140,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"thirteen_failures":"FENCE"},"why":"0.933 point estimate looks close to the bar but Wilson lower is 0.8816"}
{"id":"ho-005","kind":"wilson_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"weak_evidence","volume_share":0.5,"n":150,"successes":140,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0},{"id":"strong_evidence","volume_share":0.5,"n":500,"successes":480,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"weak_evidence":"FENCE","strong_evidence":"AUTO"},"why":"two segments with different evidence strength under one shared contract must not be averaged into one verdict"}
{"id":"ho-006","kind":"wilson_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.93,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"wide_interval","volume_share":0.5,"n":200,"successes":190,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0},{"id":"tight_interval","volume_share":0.5,"n":400,"successes":388,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"wide_interval":"FENCE","tight_interval":"AUTO"},"why":"at a 0.93 bar, lower 0.9104 fails while lower 0.9483 passes; interval width decides"}
{"id":"ho-007","kind":"wilson_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.95,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"five_hundred","volume_share":0.5,"n":500,"successes":480,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0},{"id":"one_thousand","volume_share":0.5,"n":1000,"successes":970,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"five_hundred":"FENCE","one_thousand":"AUTO"},"why":"0.96 versus 0.97 point estimates reverse around a 0.95 bar once interval width is accounted for"}
{"id":"ho-008","kind":"harm_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"high","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"irreversible","volume_share":1.0,"n":300,"successes":297,"harm_if_wrong":"critical","fallback":"rollback","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"irreversible":"FENCE"},"why":"raising the ceiling to high still excludes critical harm, and a rollback path does not override the ceiling"}
{"id":"ho-009","kind":"harm_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"low","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"medium_risk","volume_share":1.0,"n":250,"successes":240,"harm_if_wrong":"medium","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"medium_risk":"FENCE"},"why":"under a low-harm-only contract, a medium-harm segment is outside scope even with clean evidence"}
{"id":"ho-010","kind":"harm_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"high","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"at_ceiling","volume_share":1.0,"n":250,"successes":240,"harm_if_wrong":"high","fallback":"rollback","cost_per_case":0.1,"human_review_cost":0.0}],"expected":{"at_ceiling":"AUTO"},"why":"harm exactly at the ceiling is allowed, and a declared rollback satisfies the fallback gate"}
{"id":"ho-011","kind":"fallback_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"critical_uncontained","volume_share":1.0,"n":500,"successes":480,"harm_if_wrong":"critical","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"critical_uncontained":"FENCE"},"why":"strong evidence on a critical-harm segment cannot substitute for a containment path"}
{"id":"ho-012","kind":"fallback_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"degraded_only","volume_share":1.0,"n":500,"successes":480,"harm_if_wrong":"high","fallback":"degrade","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"degraded_only":"FENCE"},"why":"a degrade path satisfies G4 but the harm ceiling still fences the segment; one gate passing is not a release"}
{"id":"ho-013","kind":"cost_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"loaded_over_budget","volume_share":1.0,"n":250,"successes":240,"harm_if_wrong":"low","fallback":"human","cost_per_case":0.4,"human_review_cost":0.2}],"expected":{"loaded_over_budget":"FENCE"},"why":"the headline model cost 0.40 is under budget but the staffed fallback makes the loaded cost 0.60"}
{"id":"ho-014","kind":"cost_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"cheap_human","volume_share":1.0,"n":250,"successes":240,"harm_if_wrong":"low","fallback":"human","cost_per_case":0.05,"human_review_cost":0.05}],"expected":{"cheap_human":"AUTO"},"why":"a low-cost human fallback is affordable; the cost gate prices the real path, not the model call alone"}
{"id":"ho-015","kind":"coverage","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"lane_1","volume_share":0.2,"n":250,"successes":240,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0},{"id":"lane_2","volume_share":0.2,"n":500,"successes":480,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.03,"human_review_cost":0.0},{"id":"lane_3","volume_share":0.2,"n":1000,"successes":970,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.04,"human_review_cost":0.0}],"expected":{"lane_1":"AUTO","lane_2":"AUTO","lane_3":"AUTO"},"why":"three green lanes still leave 40 percent of traffic undeclared; green is not full"}
{"id":"ho-016","kind":"coverage","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"ok","volume_share":0.45,"n":300,"successes":297,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0},{"id":"thin","volume_share":0.15,"n":40,"successes":39,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"ok":"AUTO","thin":"HOLD"},"why":"auto plus hold plus undeclared traffic must all appear in the same denominator"}
{"id":"ho-017","kind":"clean_auto","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"steady","volume_share":1.0,"n":300,"successes":297,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.03,"human_review_cost":0.0}],"expected":{"steady":"AUTO"},"why":"a high-accuracy large sample with low harm and no unpriced fallback clears every gate"}
{"id":"ho-018","kind":"clean_auto","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"high_volume","volume_share":1.0,"n":1000,"successes":970,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.05,"human_review_cost":0.0}],"expected":{"high_volume":"AUTO"},"why":"lower 0.9575 is comfortably above the 0.90 bar at this volume"}
{"id":"ho-019","kind":"clean_auto","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"primary","volume_share":0.6,"n":250,"successes":240,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0},{"id":"secondary","volume_share":0.4,"n":400,"successes":388,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.03,"human_review_cost":0.0}],"expected":{"primary":"AUTO","secondary":"AUTO"},"why":"two green segments with fully declared traffic are the canonical AUTO case"}
{"id":"ho-020","kind":"combined","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"ten_only","volume_share":1.0,"n":10,"successes":10,"harm_if_wrong":"critical","fallback":"none","cost_per_case":1.0,"human_review_cost":0.0}],"expected":{"ten_only":"HOLD"},"why":"zero failures on ten cases plus critical harm and no fallback is the strongest possible HOLD"}
{"id":"ho-021","kind":"combined","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"three_fences","volume_share":1.0,"n":150,"successes":140,"harm_if_wrong":"high","fallback":"human","cost_per_case":0.05,"human_review_cost":0.7}],"expected":{"three_fences":"FENCE"},"why":"Wilson, harm and loaded cost all fence it while the human fallback keeps G4 quiet"}
{"id":"ho-022","kind":"combined","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"ship","volume_share":0.4,"n":300,"successes":297,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0},{"id":"fence","volume_share":0.35,"n":100,"successes":95,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0},{"id":"wait","volume_share":0.25,"n":60,"successes":59,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"ship":"AUTO","fence":"FENCE","wait":"HOLD"},"why":"a three-way split is the normal shape of a real release contract, not a single go/no-go"}
{"id":"ho-023","kind":"boundary","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"forty_all_correct","volume_share":1.0,"n":40,"successes":40,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"forty_all_correct":"HOLD"},"why":"a perfect rate can push the Wilson bound above the bar and still be HOLD because the sample gate is independent"}
{"id":"ho-024","kind":"boundary","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.45,"z":1.96},"segments":[{"id":"exactly_budget","volume_share":0.5,"n":250,"successes":240,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.45,"human_review_cost":0.0},{"id":"fraction_over","volume_share":0.5,"n":500,"successes":480,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.450001,"human_review_cost":0.0}],"expected":{"exactly_budget":"AUTO","fraction_over":"FENCE"},"why":"the strict inequality is observable at a different budget value than the dev set"}
{"id":"ho-025","kind":"fallback_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"high","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"high_allowed_no_path","volume_share":1.0,"n":300,"successes":297,"harm_if_wrong":"high","fallback":"none","cost_per_case":0.03,"human_review_cost":0.0}],"expected":{"high_allowed_no_path":"FENCE"},"why":"harm sits exactly at the raised ceiling, so G3 is quiet and G4 is the only load-bearing gate here"}
