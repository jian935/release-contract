{"id":"dev-001","kind":"sample_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"thin","volume_share":1.0,"n":40,"successes":39,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"thin":"HOLD"},"why":"n below min_sample_size means evidence is missing; HOLD outranks the Wilson FENCE triggered by the same small sample"}
{"id":"dev-002","kind":"sample_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"almost","volume_share":1.0,"n":99,"successes":98,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"almost":"HOLD"},"why":"one observation short of the sample gate with an otherwise passing bound must still be HOLD"}
{"id":"dev-003","kind":"sample_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"at_min","volume_share":1.0,"n":100,"successes":98,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"at_min":"AUTO"},"why":"n exactly at min_sample_size with Wilson lower 0.9300 above 0.9 clears both gates"}
{"id":"dev-004","kind":"wilson_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"point_ok","volume_share":1.0,"n":100,"successes":95,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"point_ok":"FENCE"},"why":"point estimate 0.95 is above threshold but Wilson lower 0.8882 is below it; the point estimate must not be used"}
{"id":"dev-005","kind":"wilson_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"at_threshold","volume_share":1.0,"n":400,"successes":360,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"at_threshold":"FENCE"},"why":"point estimate exactly 0.90 yields lower 0.8667; a rate equal to the bar is not evidence the bar is met"}
{"id":"dev-006","kind":"wilson_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"large_but_weak","volume_share":1.0,"n":1000,"successes":900,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"large_but_weak":"FENCE"},"why":"even a large sample cannot rescue a point estimate sitting on the threshold; lower is 0.8798"}
{"id":"dev-007","kind":"wilson_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.95,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"small_sample","volume_share":0.5,"n":400,"successes":388,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0},{"id":"large_sample","volume_share":0.5,"n":1000,"successes":970,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"small_sample":"FENCE","large_sample":"AUTO"},"why":"identical 0.97 point estimate, different sample sizes: lower 0.9483 versus 0.9575 around a 0.95 bar"}
{"id":"dev-008","kind":"harm_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"high_harm","volume_share":1.0,"n":300,"successes":297,"harm_if_wrong":"high","fallback":"human","cost_per_case":0.02,"human_review_cost":0.1}],"expected":{"high_harm":"FENCE"},"why":"harm above the contracted ceiling fences the segment even at 0.99 observed success and a staffed fallback"}
{"id":"dev-009","kind":"harm_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"critical_harm","volume_share":1.0,"n":300,"successes":297,"harm_if_wrong":"critical","fallback":"human","cost_per_case":0.02,"human_review_cost":0.1}],"expected":{"critical_harm":"FENCE"},"why":"critical harm is outside the contract; accuracy cannot buy an exception"}
{"id":"dev-010","kind":"harm_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"low","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"medium_harm","volume_share":1.0,"n":250,"successes":240,"harm_if_wrong":"medium","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"medium_harm":"FENCE"},"why":"tightening max_harm to low changes the verdict; the ceiling is a product decision, not an engine constant"}
{"id":"dev-011","kind":"fallback_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"no_containment","volume_share":1.0,"n":250,"successes":240,"harm_if_wrong":"high","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"no_containment":"FENCE"},"why":"high-harm segment with fallback=none has no contained damage path; both G3 and G4 fire"}
{"id":"dev-012","kind":"fallback_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"critical_no_fallback","volume_share":1.0,"n":250,"successes":240,"harm_if_wrong":"critical","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"critical_no_fallback":"FENCE"},"why":"critical harm without any fallback is fenced regardless of the evidence strength"}
{"id":"dev-013","kind":"cost_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"hidden_human_cost","volume_share":1.0,"n":250,"successes":240,"harm_if_wrong":"low","fallback":"human","cost_per_case":0.05,"human_review_cost":0.8}],"expected":{"hidden_human_cost":"FENCE"},"why":"the model call is cheap but the human fallback it requires pushes loaded cost to 0.85"}
{"id":"dev-014","kind":"cost_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"affordable_human","volume_share":1.0,"n":250,"successes":240,"harm_if_wrong":"low","fallback":"human","cost_per_case":0.1,"human_review_cost":0.2}],"expected":{"affordable_human":"AUTO"},"why":"adding the human cost still lands at 0.30, under the 0.50 budget; the gate is not anti-human-review"}
{"id":"dev-015","kind":"coverage","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"declared_a","volume_share":0.4,"n":250,"successes":240,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0},{"id":"declared_b","volume_share":0.3,"n":500,"successes":480,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.03,"human_review_cost":0.0}],"expected":{"declared_a":"AUTO","declared_b":"AUTO"},"why":"both declared segments pass, but 30 percent of traffic is undeclared; the global gate reports it instead of calling the release full"}
{"id":"dev-016","kind":"coverage","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"auto_part","volume_share":0.55,"n":250,"successes":240,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0},{"id":"fenced_part","volume_share":0.2,"n":100,"successes":95,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"auto_part":"AUTO","fenced_part":"FENCE"},"why":"mixed verdicts plus undeclared traffic must be shown as four buckets that still sum to full traffic"}
{"id":"dev-017","kind":"clean_auto","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"healthy","volume_share":1.0,"n":250,"successes":240,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"healthy":"AUTO"},"why":"all five per-segment gates pass and the declared share covers full traffic"}
{"id":"dev-018","kind":"clean_auto","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"larger","volume_share":1.0,"n":500,"successes":480,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.04,"human_review_cost":0.0}],"expected":{"larger":"AUTO"},"why":"larger sample with lower 0.9390 clears the same contract"}
{"id":"dev-019","kind":"clean_auto","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"tier_a","volume_share":0.5,"n":250,"successes":240,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0},{"id":"tier_b","volume_share":0.3,"n":500,"successes":480,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.03,"human_review_cost":0.0},{"id":"tier_c","volume_share":0.2,"n":1000,"successes":970,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.05,"human_review_cost":0.0}],"expected":{"tier_a":"AUTO","tier_b":"AUTO","tier_c":"AUTO"},"why":"three differently sized segments all clear the gates and together cover 100 percent of traffic"}
{"id":"dev-020","kind":"combined","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"everything_wrong","volume_share":1.0,"n":50,"successes":49,"harm_if_wrong":"critical","fallback":"none","cost_per_case":0.9,"human_review_cost":0.0}],"expected":{"everything_wrong":"HOLD"},"why":"all five gates fire; HOLD is the strictest verdict and must win over the four FENCE hits"}
{"id":"dev-021","kind":"combined","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"four_fences","volume_share":1.0,"n":100,"successes":95,"harm_if_wrong":"high","fallback":"none","cost_per_case":0.7,"human_review_cost":0.0}],"expected":{"four_fences":"FENCE"},"why":"no sample gate here, so the four FENCE hits decide the verdict"}
{"id":"dev-022","kind":"combined","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"thin","volume_share":0.5,"n":40,"successes":39,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0},{"id":"solid","volume_share":0.5,"n":250,"successes":240,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"thin":"HOLD","solid":"AUTO"},"why":"a release can be partial: one segment waits for evidence while another ships"}
{"id":"dev-023","kind":"boundary","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"perfect_but_tiny","volume_share":1.0,"n":30,"successes":30,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"perfect_but_tiny":"HOLD"},"why":"zero observed failures is not proof: Wilson lower is only 0.8865 and n is below the sample gate"}
{"id":"dev-024","kind":"boundary","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"medium","max_cost_per_case":0.3,"z":1.96},"segments":[{"id":"at_budget","volume_share":0.5,"n":250,"successes":240,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.3,"human_review_cost":0.0},{"id":"over_budget","volume_share":0.5,"n":250,"successes":240,"harm_if_wrong":"low","fallback":"none","cost_per_case":0.3001,"human_review_cost":0.0}],"expected":{"at_budget":"AUTO","over_budget":"FENCE"},"why":"the cost gate uses a strict greater-than; spending exactly the budget is allowed"}
{"id":"dev-025","kind":"fallback_gate","guardrails":{"min_sample_size":100,"min_success_rate":0.9,"max_harm":"critical","max_cost_per_case":0.5,"z":1.96},"segments":[{"id":"allowed_but_uncontained","volume_share":1.0,"n":250,"successes":240,"harm_if_wrong":"critical","fallback":"none","cost_per_case":0.02,"human_review_cost":0.0}],"expected":{"allowed_but_uncontained":"FENCE"},"why":"the contract allows critical harm so G3 is quiet and G4 alone carries the fence; ablating G4 would incorrectly ship this segment"}
